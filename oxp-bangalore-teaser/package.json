{
  "name": "oxp-bangalore-teaser",
  "version": "1.0.0",
  "private": true,
  "description": "Odoo Community Days Bangalore: 21-second kinetic typography teaser (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "music": "tsx scripts/edit-music.ts",
    "render": "remotion render Teaser-4x5 out/oxp-bangalore-teaser-4x5.mp4",
    "render:1x1": "remotion render Teaser-1x1 out/oxp-bangalore-teaser-1x1.mp4",
    "render:16x9": "remotion render Teaser-16x9 out/oxp-bangalore-teaser-16x9.mp4",
    "still": "remotion still Teaser-4x5",
    "typecheck": "tsc --noEmit",
    "sfx": "tsx scripts/make-sfx.ts",
    "audio": "tsx scripts/edit-music.ts && tsx scripts/make-sfx.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/paths": "4.0.535",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
